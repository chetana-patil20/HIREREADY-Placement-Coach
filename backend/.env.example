# --- HireReady backend configuration ---

# SQLite by default. Swap for a Postgres URL later, e.g.
# DATABASE_URL=postgresql://user:password@localhost:5432/hireready
DATABASE_URL=sqlite:///./hireready.db

# Secret used to sign JWTs. Change this in production.
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI integration (optional) ---
# If AI_API_KEY is left blank, the app automatically falls back to a
# deterministic, profile-aware mock AI service. Nothing crashes and every
# AI-powered feature (coach, resume analyzer, mock interview feedback)
# still works, just without a real LLM behind it.
#
# Supported providers: "gemini", "openai", or "anthropic". Leave AI_PROVIDER blank to
# force fallback mode even if a key is present.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# --- Email ownership verification (required for new registrations) ---
# Example Gmail SMTP settings. Create an app password in your Google Account;
# never enter your regular Gmail password here or share this file publicly.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=your.email@gmail.com
SMTP_FROM_NAME=HireReady
SMTP_USE_TLS=true
SMTP_SSL=false

# CORS - comma separated origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
